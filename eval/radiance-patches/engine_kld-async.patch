 namespace rad {
 
+/* LOCAL MEASUREMENT PATCH (not for upstream): asynchronous scored-row copies. The sync path copies a step's f32
+ * logits (n_rows x vocab, ~2 GB at 2048 rows) to the host and scores them while the card idles; over a PCIe3 x4
+ * link that is ~40 s an eval. Here each rank copies the rows into a device staging buffer on the compute stream
+ * (cheap D2D), a second stream moves them to the pinned host buffer, and a host thread waits for that copy and
+ * scores, while the card already runs the next step. At most one step in flight: score_rows joins the previous
+ * job before it reuses the buffers, and run_kld joins the last one before finish(). RADIANCE_KLD_SYNC=1 keeps the
+ * old path; a staging buffer that cannot be allocated falls back to it too. */
+namespace {
+struct KldAsync {
+    bool on = false;
+    std::vector<void*> stage;
+    std::vector<RadStream> copy_stream;
+    std::vector<RadEvent> staged, copied;
+    std::thread job;
+    std::atomic<int> rc{ RAD_OK };
+    int join() {
+        if (job.joinable()) job.join();
+        return rc.exchange(RAD_OK);
+    }
+    ~KldAsync() { if (job.joinable()) job.join(); }
+};
+KldAsync g_async;
+}  /* namespace */
