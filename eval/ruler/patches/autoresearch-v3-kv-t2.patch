+    # ---- T2 over the RULER harness (rad-exl3-mix eval/ruler: NVIDIA's generators, versioned set) -------------
+    def t2_rlib(self, prod: Path, recipe_dir: Path, refs: Json) -> Json:
+        """The candidate and the anchors on the profile's selection of a RULER set on the bench host (the same rows
+        for every setup); scored with RULER's metrics (rlib.score), compared paired (rlib.paired: per-row bootstrap
+        within cells). Rejected when the candidate is worse than an anchor beyond chance: the paired difference's
+        95% upper bound below -tol_points overall, or below -tol_length_points at any length."""
+        import rlib
+        m = self.model
+        rs = m['ruler']
+        setdir = rs['set']
+        mid = rlib.manifest_id(setdir)
+        sel = rs['select']
+        cells = {c: (list(range(v)) if isinstance(v, int) else sorted(v)) for c, v in sel['cells'].items()}
+        got = rlib.cells_sha256(setdir, cells)
+        if rs.get('set_sha256') and got != rs['set_sha256']:
+            raise Infra(f"RULER set {setdir}: the selection's rows hash {got}, the profile pins {rs['set_sha256']}")
+        mid['cells_sha256'] = got
+        fit = int(m.get('max_depth_fit', 1 << 30))
+        skipped = sorted(c for c in cells if rlib.split_cell(c)[1] > fit)
+        cells = {c: v for c, v in cells.items() if c not in skipped}
+        samples = rlib.select(setdir, cells)
+        template = rs.get('template', 'chat')
+        out: Json = {'set': mid, 'select': sel.get('name'), 'template': template, 'skipped': skipped,
+                     'reports': {}, 'paired': {}, 'ok': True}
+        setups: list[tuple[str, Json, Path | None, Path]] = [('cand', self.setup, recipe_dir, prod)]
+        base_prod = self.root / 'base' / self.pid / self.bid / 'products'
+        for a in rs.get('anchors', ['fp8']):
+            setups.append((a, next(x['setup'] for x in m['anchors'] if x['name'] == a)
+                           if a != 'bf16' else {'kv_cache_dtype': 'bf16'}, None, base_prod))
+        cache = self.root / 'refs' / refs['key'] / 'ruler'
+        cache.mkdir(parents=True, exist_ok=True)
+        tag = f"{sel.get('name', 'sel')}-{mid['cells_sha256'][:12]}-{template}"
+        res: dict[str, list[Json]] = {}
+        for name, st, rdir, pr in setups:
+            cp = cache / f'{name}-{tag}.json'
+            if name != 'cand' and cp.exists():
+                res[name] = json.loads(cp.read_text())
+                continue
+            todo = [s for s in samples
+                    if not (name == 'bf16' and int(s['max_length']) > int(m.get('bf16_depth_fit', 0)))]
+            if not todo:
+                continue
+            res[name] = self.rlib_run(pr, st, rdir, f'{name}-{tag}', todo, template)
+            if name != 'cand':
+                K.write_json(cp, res[name])
+        tol = float(rs.get('tol_points', 0.0))
+        tol_len = float(rs.get('tol_length_points', 10.0))
+        for name, r in res.items():
+            out['reports'][name] = rlib.report(r, boot=1000)
+        for a in rs.get('anchors', ['fp8']):
+            if a not in res:
+                continue
+            p = rlib.paired(res[a], res['cand'], boot=2000)
+            out['paired'][a] = p
+            if p['diff_ci95'][1] < -tol:
+                out['ok'] = False
+                out.setdefault('failed', []).append(
+                    f"overall: cand - {a} = {p['diff']:+.2f} points, 95% CI [{p['diff_ci95'][0]:+.2f}, "
+                    f"{p['diff_ci95'][1]:+.2f}] (< -{tol})")
+            for L, v in p['by_length'].items():
+                if v['ci95'][1] < -tol_len:
+                    out['ok'] = False
+                    out.setdefault('failed', []).append(
+                        f"{L}: cand - {a} = {v['diff']:+.2f}, 95% CI upper {v['ci95'][1]:+.2f} (< -{tol_len})")
+        out['drafter'] = 'acceptance read from /metrics during the probes' if m.get('drafter') \
+            else 'n/a (the model profile has no drafter)'
+        return out
+
+    def rlib_run(self, prod: Path, setup: Json, recipe_dir: Path | None, tag: str,
+                 samples: list[Json], template: str) -> list[Json]:
+        """rlib samples over as many holds as it takes (a server per hold); text prompts (the server tokenizes:
+        eval/ruler's rrun.py checks that radiance's tokenization of the rendered text equals the tokenizer.json's)."""
+        import rlib
+        m = self.model
+        done: list[Json] = []
+        need = max(int(s['max_length']) for s in samples) + 256       # + the chat markup
+        while len(done) < len(samples):
+            port = free_port()
+            extra = ['--max-model-len', str(need), '--max-num-seqs', '1',
+                     '--max-num-batched-tokens', str(m.get('speed_chunk', 2048)),
+                     '--host', '127.0.0.1', '--port', str(port)] + list(m.get('ruler', {}).get('flags', [])) \
+                + list(m.get('speed_flags', []))
+            argv = K.sandboxed(self.engine_argv(prod, setup, extra, recipe_dir), self.host)
+            lg = self.jd / f'server-ruler-{tag}.log'
+
+            def go(deadline: float) -> None:
+                self.mem_ok(f'ruler {tag}', engine=True)
+                srv = kvserve.Server(argv, self.env(prod), lg, self.run, port,
+                                     mem_kill_gb=float(self.host['mem_kill_gb']))
+                try:
+                    srv.start(min(deadline, time.time() + float(m.get('load_timeout_s', 400))))
+                    rate = 0.0          # seconds a token of length, the worst seen in this hold
+                    while len(done) < len(samples):
+                        s = samples[len(done)]
+                        if rate and time.time() + 1.3 * rate * int(s['max_length']) > deadline:
+                            return
+                        t0 = time.time()
+                        text = srv.complete(rlib.render(s, template), int(s['tokens_to_generate']),
+                                            deadline=deadline)
+                        dt = time.time() - t0
+                        rate = max(rate, dt / int(s['max_length']))
+                        done.append({'task': s['task'], 'length': int(s['max_length']), 'index': int(s['index']),
+                                     'cell': s['cell'], 'key': s['key'], 'score': rlib.score(s, text),
+                                     'pred': text[:200], 'seconds': round(dt, 2)})
+                except (kvserve.ServerDied, OSError) as e:
+                    if srv.mem_killed is not None:
+                        raise K.Killed(f'ruler {tag}: MemAvailable {srv.mem_killed:.2f} GB')
+                    raise EngineFailed(f'ruler {tag}', getattr(e, 'rc', -1), K.tail(lg, 2500))
+                finally:
+                    srv.stop()
+            n0 = len(done)
+            self.retry_mem(f't2 ruler {tag}', lambda: self.hold(f't2 ruler {tag}', go))
+            if len(done) == n0:
+                raise Infra(f'ruler {tag}: one sample does not fit a hold')
+        return done
+
+
 class EngineFailed(Exception):
     def __init__(self, what: str, rc: int, tail: str) -> None:
         super().__init__(what)
