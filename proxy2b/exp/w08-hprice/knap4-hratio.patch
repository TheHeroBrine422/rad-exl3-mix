+if os.environ.get("KN_HRATIO"):
+    HR = collections.defaultdict(dict)          # knap name -> K -> ratio
+    _acc = collections.defaultdict(list)
+    for l in open(os.environ["KN_HRATIO"]):
+        d = json.loads(l); k = d["key"].split(".")
+        n = HF2KN.get(".".join(k[4:6])) if len(k) > 5 and k[2] == "layers" else None
+        if n and d.get("r", 0) > 0: _acc[(f"blk.{k[3]}.{n}.weight", float(d["K"]))].append(d["r"])
+    for (n, K), v in _acc.items(): HR[n][K] = math.exp(sum(map(math.log, v)) / len(v))
+    HF, HONLY, NH = float(os.environ.get("KN_HF", 1.0)), os.environ.get("KN_HONLY") == "1", 0
+    def hratio(w, K):
+        m = HR.get(w)
+        if not m: return None
+        if K in m: return m[K]
+        lo, hi = [k for k in m if k < K], [k for k in m if k > K]
+        if lo and hi:
+            a_, b_ = max(lo), min(hi); return math.exp(math.log(m[a_]) + (K - a_) / (b_ - a_) * (math.log(m[b_]) - math.log(m[a_])))
