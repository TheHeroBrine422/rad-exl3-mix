diff --git a/exllamav3/modules/quant/exl3_lib/quantize.py b/exllamav3/modules/quant/exl3_lib/quantize.py
index c89b20ee..7c3b8fdd 100644
--- a/exllamav3/modules/quant/exl3_lib/quantize.py
+++ b/exllamav3/modules/quant/exl3_lib/quantize.py
@@ -99,20 +99,27 @@ def get_temp_buffers(device, K: int, tile_len: int = 256, cb: int = 0):
     return temp_costs, temp_edges
 
 
+def frac_mask(n: int) -> int:
+    """Canonical period-16 step mask with n extra bits per 16 steps, spread evenly: bit i is set when step i
+    carries the extra bit, i.e. floor((i + 1) n / 16) - floor(i n / 16) = 1 (n = 4: 0x8888, 8: 0xAAAA, 12: 0xEEEE)"""
+    return sum(1 << i for i in range(16) if ((i + 1) * n) // 16 - (i * n) // 16)
+
+
 def frac_k(K):
-    """(KA, MASK) for a half-integer bitrate K = KA + 0.5: alternating KA- and (KA + 1)-bit trellis
-    steps (MASK 0xAAAA, period 16). None for integer K. Half steps keep every tile a whole number of
-    32-bit words (streamable with int4 loads); the kernels accept any period-16 pattern, but only the
-    alternating one is instantiated."""
+    """(KA, MASK) for a fractional bitrate K = KA + n / 16 (0 < n < 16): KA- and (KA + 1)-bit trellis steps in the
+    canonical even pattern (frac_mask), period 16. None for integer K. The tile must stay a whole number of 32-bit
+    words, so n is even; the quantizer has instances for the V3 menu (n = 4, 8, 12 for KA 1-4; n = 8 for KA 5-7)."""
     if isinstance(K, int) or float(K).is_integer():
         return None
     ka = int(K)
-    assert abs(ka + 0.5 - K) < 1e-9, f"fractional bitrate {K} must be a half-integer"
-    return ka, 0xAAAA
+    n = (K - ka) * 16
+    assert ka >= 1 and abs(n - round(n)) < 1e-9 and round(n) % 2 == 0, \
+        f"fractional bitrate {K}: need KA >= 1 and K = KA + n / 16 with n even"
+    return ka, frac_mask(round(n))
 
 
 def trellis_words(K) -> int:
-    """uint16 words per 256-weight tile at bitrate K (16 * K, an integer for half-integer K)"""
+    """uint16 words per 256-weight tile at bitrate K (16 * K, an integer for any K in steps of 1/16)"""
     w = 16 * K
     assert float(w).is_integer(), f"bitrate {K}: tile is not a whole number of uint16 words"
     return int(w)
