@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""check_reldlq.py BASE_PIPE FORK [WORK] -- CPU checks (rxq/cpukern.py stand-in kernels, the fork's real quantize.py) of
+w115's patch: rxq/reldlq.py (#152, re-LDLQ after the refit) and tile CD's gate / up family names (#153). Tiny two-layer
+model as check_cpujob.py (layer 2 GDN + MLP, layer 3 attention + MLP), K2.5 and K0.5 i8, H_out blocks (today's settings).
+  off      the patched pipeline with no [quant.reldlq] (today's settings file) == BASE_PIPE (rad-exl3-mix HEAD's
+           pipeline/, unpatched): every t-file's tensors bit-identical, same settings stamp
+  stamp    a settings file with [quant.reldlq] enable = false has another stamp but the same t-files as off
+  on       [quant.reldlq] enable = true, passes = 1: every tensor stored, each log record has two passes, pass 0's
+           proxy == the off run's proxy_err (the first pass is today's quantization), the stored t-files differ from
+           off's on most tensors, the decoded t-file == the job's wq (f16), q_proj still runs tile CD twice (two
+           tilecd.jsonl lines), the record's diag traj has pass0
+  cdfam    tile CD families + ffn_gate (then ffn_up, ffn_down, ssm_qkv, attn_v) one at a time: tilecd.jsonl lists q_proj
+           and exactly that family's keys; tensors outside it bit-identical to off; the alias ffn_gate_up = gate + up
+Last line: "RELDLQ CHECKS n/m PASS"."""
+import json, os, re, subprocess, sys, tempfile
+
+import numpy as np
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PIPE = os.path.normpath(os.path.join(HERE, ".."))
+
+if len(sys.argv) > 1 and sys.argv[1] == "--run":          # child: one job (one engine setup a process)
+    sys.path.insert(0, sys.argv[4])
+    from rxq import job
+    spec = json.load(open(sys.argv[2]))
+    job.run_quant(spec, sys.argv[3], device="cpu", save_wq=True)
+    sys.exit(0)
+
+sys.path.insert(0, PIPE)
+from rxq import config as C, deq, job, qwen35  # noqa: E402
+
+BASE, FORK = sys.argv[1], sys.argv[2]
+W = sys.argv[3] if len(sys.argv) > 3 else tempfile.mkdtemp(prefix="w115chk-")
+res = []
+
+
+def report(name, ok, why):
+    res.append(bool(ok)); print(f"{'PASS' if ok else 'FAIL'} {name}: {why}", flush=True)
+
+
+SH = {"ssm_qkv": (384, 256), "ssm_z": (256, 256), "ssm_out": (256, 256), "attn_qg": (256, 256), "attn_k": (128, 256),
+      "attn_v": (128, 256), "attn_output": (256, 256), "ffn_gate": (384, 256), "ffn_up": (384, 256), "ffn_down": (256, 384)}
+g = torch.Generator().manual_seed(115)
+ck, hs, ho = f"{W}/ckpt", f"{W}/hess", f"{W}/hout/bn1920"
+for d in (ck, hs, ho): os.makedirs(d, exist_ok=True)
+tens, keys = {}, []
+for l in (2, 3):
+    for hname, ks in qwen35.layer_plan(l):
+        k_in = SH[qwen35.family(ks[0])][1]
+        A = torch.randn(4 * k_in, k_in, generator=g) * torch.linspace(0.3, 2.0, k_in)
+        H = (A.T @ A).float(); iu = torch.triu_indices(k_in, k_in)
+        save_file({"hessian_upper": H[iu[0], iu[1]].contiguous()}, f"{hs}/{hname}.safetensors", metadata={"k": str(k_in), "rows": str(4 * k_in)})
+        for key in ks:
+            n, k = SH[qwen35.family(key)]
+            tens[f"{key}.weight"] = (torch.randn(n, k, generator=g) * 0.02).to(torch.bfloat16)
+            save_file({"hout_diag": (torch.rand(n, generator=g) + 0.1).float()}, f"{ho}/{key}.safetensors")
+            keys.append(key)
+save_file(tens, f"{ck}/model.safetensors")
+
+base = open(os.path.join(PIPE, "config", "v3.toml")).read()
+assert base == open(os.path.join(BASE, "config", "v3.toml")).read(), "the patch must not touch v3.toml"
+def cdfams(fams): return re.sub(r'^families = \["attn_qg"\]', "families = " + json.dumps(fams), base, count=1, flags=re.M)
+CFGS = {"off": base, "rl0": base + "\n[quant.reldlq]\nenable = false\npasses = 1\n",
+        "rl1": base + "\n[quant.reldlq]\nenable = true\npasses = 1\n"}
+for f in ("ffn_gate", "ffn_up", "ffn_down", "ssm_qkv", "attn_v", "ffn_gate_up"): CFGS[f"cd-{f}"] = cdfams(["attn_qg", f])
+for m, t in CFGS.items(): open(f"{W}/{m}.toml", "w").write(t)
+
+
+def run(name, pipe, cfgname, K):
+    out = f"{W}/out-{name}-K{K}"
+    cfg = C.load(f"{W}/{cfgname}.toml"); st = C.settings_stamp(cfg)
+    for gi, ks in enumerate([list(ks) for l in (2, 3) for _, ks in qwen35.layer_plan(l)]):
+        spec = {"type": "rxq.quant", "version": 1, "level": f"t-k{K}-i8", "K": K, "codebook": "i8", "seed_offset": 0, "keys": ks,
+                "settings_stamp": st, "config": f"{W}/{cfgname}.toml",
+                "inputs": {"ckpt": ck, "hessians": hs, "hin": None, "wpre": None, "hout": ho}}
+        sp = f"{W}/spec-{name}-K{K}-{gi}.json"; json.dump(spec, open(sp, "w"))
+        env = dict(os.environ, RXQ_CPU_STANDIN="1", RXQ_EXL3_SRC=f"{FORK}/exllamav3/exllamav3_ext", PYTHONPATH=pipe,
+                   OMP_NUM_THREADS="2", RXQ_RXM=os.path.dirname(pipe))
+        r = subprocess.run([sys.executable, __file__, "--run", sp, out, pipe], env=env, capture_output=True, text=True)
+        if r.returncode: print(r.stdout[-1500:], r.stderr[-3000:]); return out, st, False
+    return out, st, True
+
+
+def tfile(out, key):
+    with safe_open(job.tensor_file(out, key), "pt") as f: return {n.rsplit(".", 1)[1]: f.get_tensor(n) for n in f.keys()}
+
+
+def same(a, b): return a.keys() == b.keys() and all(torch.equal(a[n], b[n]) for n in a)
+
+
+def recs(out): return {json.loads(x)["key"]: json.loads(x) for x in open(f"{out}/log.jsonl")}
+
+
+def cdkeys(out):
+    p = f"{out}/tilecd.jsonl"
+    return [json.loads(x)["key"] for x in open(p)] if os.path.exists(p) else []
+
+
+lut = torch.from_numpy(deq.codebook_lut("i8").astype(np.float32))
+for K in (2.5, 0.5):
+    ob, sb, okb = run("base", BASE, "off", K)
+    oo, so, oko = run("off", PIPE, "off", K)
+    report(f"off-K{K}", okb and oko and sb == so and all(same(tfile(ob, k), tfile(oo, k)) for k in keys),
+           f"patched pipeline, no [quant.reldlq], == HEAD's pipeline on {len(keys)} tensors (stamp {so})")
+    o0, s0, ok0 = run("rl0", PIPE, "rl0", K)
+    report(f"stamp-K{K}", ok0 and s0 != so and all(same(tfile(o0, k), tfile(oo, k)) for k in keys),
+           f"enable = false: stamp {s0} (!= {so}), t-files == off")
+    o1, s1, ok1 = run("rl1", PIPE, "rl1", K)
+    if ok1:
+        R0, R1 = recs(oo), recs(o1)
+        two = all(len(R1[k].get("reldlq", [])) == 2 for k in keys)
+        p0 = max(abs(R1[k]["reldlq"][0]["proxy_err"] - R0[k]["proxy_err"]) / R0[k]["proxy_err"] for k in keys) if two else 1.0
+        nd = sum(not same(tfile(o1, k), tfile(oo, k)) for k in keys)
+        worst = 0.0
+        for k in keys:
+            t = tfile(o1, k); Wd = deq.weight(t["trellis"], t["suh"], t["svh"], K, lut)
+            with safe_open(f"{o1}/wq/{k}.safetensors", "pt") as f: wq = f.get_tensor("weight").float().T
+            worst = max(worst, float((Wd - wq).norm() / wq.norm()))
+        cdk = cdkeys(o1); q = [k for k in keys if qwen35.family(k) == "attn_qg"]
+        tr = all("pass0" in R1[k].get("diag", {}).get("traj", {}) for k in keys)
+        ratio = [round(R1[k]["reldlq"][1]["proxy_err"] / R1[k]["reldlq"][0]["proxy_err"], 4) for k in keys]
+        report(f"on-K{K}", two and p0 < 1e-12 and nd >= len(keys) // 2 and worst < 2e-3 and cdk == [x for x in q for _ in (0, 1)] and tr,
+               f"2 passes {two}, pass-0 proxy == off (max rel {p0:.1e}), {nd}/{len(keys)} t-files differ, decode {worst:.1e}, "
+               f"tile CD lines {len(cdk)} (q_proj x2), traj pass0 {tr}; pass1/pass0 proxy {ratio}")
+    else: report(f"on-K{K}", False, "run failed")
+
+for f in ("ffn_gate", "ffn_up", "ffn_down", "ssm_qkv", "attn_v", "ffn_gate_up"):
+    oc, sc, okc = run(f"cd-{f}", PIPE, f"cd-{f}", 2.5)
+    fam = {"ffn_gate_up": ("ffn_gate", "ffn_up")}.get(f, (f,))
+    want = [k for k in keys if qwen35.family(k) in ("attn_qg",) + fam]
+    oo = f"{W}/out-off-K2.5"
+    rest = all(same(tfile(oc, k), tfile(oo, k)) for k in keys if k not in want or qwen35.family(k) == "attn_qg")
+    nd = sum(not same(tfile(oc, k), tfile(oo, k)) for k in want if qwen35.family(k) != "attn_qg")
+    report(f"cdfam-{f}", okc and sorted(cdkeys(oc)) == sorted(want) and rest,
+           f"tile CD on {sorted(set(qwen35.family(k) for k in want))}: tilecd.jsonl {len(cdkeys(oc))} keys (want {len(want)}), "
+           f"other tensors == off {rest}, {nd} family tensors changed")
+print(f"RELDLQ CHECKS {sum(res)}/{len(res)} PASS")
+sys.exit(0 if all(res) else 1)
