index 0000000..0a3163c
--- /dev/null
+++ b/pipeline/rxq/reldlq.py
@@ -0,0 +1,70 @@
+# Copyright 2026 Hero422. Licensed under the Apache License, Version 2.0 (see LICENSE).
+"""Re-LDLQ after the refit (#152, w115 2026-11-12; ideas round 2 rank 22). EXPERIMENT SWITCH, off unless the settings
+file has [quant.reldlq] with enable = true (absent table: off, settings stamp unchanged).
+
+Today LDLQ picks the codes against the pre-refit scales (regularize's output / input channel scales and g_scale), then
+the refit moves su / sv. With quant_args["reldlq"] = P (> 0) quantize_exl3 runs P more passes: each pass regularizes
+the ORIGINAL weight with the previous pass's stored scales (suh / svh as f16, so the target is what the previous pass
+ships; g = 1, since su already carries 1 / g), and then runs exactly the normal path: scaled_ldl in the new su,
+prepare_H_out in the new sv, LDLQ (tile CD where the family has it, the #117 block order), the dequant and the refit
+(quant.refit mode, R14 clamp) again. The last pass's result is stored; nothing else changes (same seed, same Hessians).
+
+install(Q) wraps Q.quantize_exl3 outermost (outside the #117 block order's wrapper, so its once-a-call checks hold per
+pass) and is a pass-through for quant_args without "reldlq". Per tensor quant_args["reldlq_rec"] = per pass: the
+refit's logged proxy (undamped calib H_in metric, original basis), and seconds; pass 0 = the normal quantization."""
+import time
+
+import torch
+
+from . import refit
+
+
+def install(Q):
+    if getattr(Q, "_rxq_reldlq", False): return
+    inner = Q.quantize_exl3
+
+    def quantize_exl3(weight, H_data, quant_args, return_weight_q, *a, **kw):
+        P = int(quant_args.get("reldlq") or 0)
+        if P <= 0: return inner(weight, H_data, quant_args, return_weight_q, *a, **kw)
+        w0 = weight.clone() if weight.numel() <= 5e8 else weight.cpu().clone()   # quantize_exl3 regularizes in place
+        t0 = time.time()
+        r = inner(weight, H_data, quant_args, return_weight_q, *a, **kw)
+        recs = [{"pass": 0, "proxy_err": float(r[1]), "s": round(time.time() - t0, 2)}]
+        ctx_out = refit._CTX.get("out") if refit._CTX else None
+        traj0 = dict(ctx_out.get("traj", {})) if ctx_out else {}
+        g0, zeros0 = quant_args.get("g_scale"), quant_args.get("zeros")
+        for p in range(1, P + 1):
+            if quant_args.get("q_fallback"): break                      # fallback tensors: no LDLQ to redo
+            t1 = time.time()
+            su = r[2]["suh"].float().view(-1, 1); sv = r[2]["svh"].float().view(1, -1)
+            r = None                                                     # free the previous pass's weight_q first
+            orig_reg = Q.regularize
+            Q.regularize = _regularize2(Q, su, sv, zeros0)
+            try:
+                r = inner(w0.clone().to(weight.device), H_data, quant_args, return_weight_q, *a, **kw)
+            finally:
+                Q.regularize = orig_reg
+            recs.append({"pass": p, "proxy_err": float(r[1]), "s": round(time.time() - t1, 2)})
+        quant_args["g_scale"] = g0                                       # the record keeps pass 0's search result
+        quant_args["reldlq_rec"] = recs
+        if ctx_out is not None and traj0: refit._CTX["out"].setdefault("traj", {})["pass0"] = traj0
+        del w0
+        return r
+
+    Q.quantize_exl3 = quantize_exl3
+    Q._rxq_reldlq = True
+
+
+def _regularize2(Q, su_f, sv_f, zeros0):
+    """regularize() with the scales fixed: W / sv, output Hadamard, / su, input Hadamard (regularize's order and
+    in-place ops); zero scales (zero channels) divide by 1 and stay 0 in the stored vectors"""
+    def regularize(weight, su, sv, quant_args, verbose, H_diag, pb, skip_g_scale=False, q_fallback=False):
+        quant_args["out_scales_hessian"] = False
+        quant_args["zeros"] = bool(zeros0)
+        s_v = sv_f.to(weight.device, torch.float); s_u = su_f.to(weight.device, torch.float)
+        weight /= torch.where(s_v == 0, torch.ones_like(s_v), s_v)
+        Q.blockwise_preapply_had_r_(weight, Q.had_n)
+        weight /= torch.where(s_u == 0, torch.ones_like(s_u), s_u)
+        Q.blockwise_preapply_had_l_(weight, Q.had_k)
+        return True, weight, 1.0, s_u.clone(), s_v.clone()
+    return regularize
