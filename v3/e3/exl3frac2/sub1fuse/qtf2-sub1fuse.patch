+// v10 (#142): where qtf2_forward0 stores the 15-bit node n (costs and history bytes): bits 0-1 stay, bits 9-14 -> 2-7,
+// bits 2-8 -> 8-14
+__device__ __forceinline__ uint32_t qtf2_adr0(uint32_t n)
+{
+    return (n & 3u) | (((n >> 9) & 63u) << 2) | (((n >> 2) & 127u) << 8);
+}
