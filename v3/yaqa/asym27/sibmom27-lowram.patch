+    hdr, off = {}, 0
+    for s in "HCN":
+        k = tot[s].shape; nb = 4 * k[0] * k[1]
+        hdr[s] = {"dtype": "F32", "shape": list(k), "data_offsets": [off, off + nb]}; off += nb
+    hdr["__metadata__"] = metadata
+    hb = json.dumps(hdr, separators=(",", ":")).encode(); hb += b" " * (-len(hb) % 8)
+    with open(path, "wb") as fh:
