-  tab[n] = {dev, stream, (unsigned*)base + (size_t)used[dev]++ * EXL3I_KCTR_N};
+  tab[n] = {dev, stream, key, (unsigned*)base + (size_t)used[dev]++ * EXL3I_KCTR_N};
