     def is_done(self, lv): return level_current(self.D(lv), self.cfg, lv, self.steps)
 
+    def level_stamp(self, lv):
+        p = f"{self.D(lv)}/level/stamp.json"
+        return json.load(open(p))[-1].get("stamp") if os.path.exists(p) else None
+
+    def swj_done(self, lv):
+        """the level's swj pass is done FOR ITS CURRENT ASSEMBLY (w151, #177-03: a requantized level reused the old level's
+        scales because .done was keyed by the level name only). The pass writes level/stamp.json's stamp beside .done; an
+        older .done without it counts only if it is newer than the level's stamp.json. A stale pass dir is removed."""
+        d = f"{self.swjdir()}/{lv['name']}"
+        if not os.path.exists(f"{d}/.done"): return False
+        ls, sp = f"{d}/level_stamp", f"{self.D(lv)}/level/stamp.json"
+        ok = (open(ls).read().strip() == (self.level_stamp(lv) or "")) if os.path.exists(ls) else \
+             (not os.path.exists(sp) or os.path.getmtime(f"{d}/.done") >= os.path.getmtime(sp))
+        if not ok:
+            self.log(f"{lv['name']}: swj pass {d} was fitted on another assembly of this level: redo")
+            shutil.rmtree(d, ignore_errors=True)
+        return ok
+
