# Copy to .env next to compose.yaml and edit. Every line is optional (defaults shown). The v0 names (RXMQ_*) are
# still read in 0.2; use RADQUANT_*.
#RADQUANT_IMAGE=radquant-server:0.2.0
# Run as this uid:gid. With bind mounts, the DB and OUT dirs must be writable by it (chown 10001:10001 DIR, or
# set your own uid here).
#RADQUANT_UID=10001
#RADQUANT_GID=10001

# Where state lives: a volume name (no /) or a host path (bind mount).
#   DB      queue.sqlite (+ -wal / -shm). Local filesystem only, not NFS.
#   DATA    the per-file inputs served to workers + manifest.json (server: read-only; `run --rm admin` writes it):
#           models/ (per-layer weights, Hessians, ladder pieces), goldens/, corpora/
#   OUT     results/ (accepted outputs, one dir per job) and spool/ (uploads in flight): one filesystem
#   SOURCES read-only: the bf16 checkpoint / Hessians that datapack links from (symlinks in DATA point here, so
#           run datapack through `docker compose run --rm admin` with paths under /srv/radquant/sources)
#RADQUANT_DB_DIR=/srv/queue/db
#RADQUANT_DATA_DIR=/srv/queue/data
#RADQUANT_OUT_DIR=/srv/queue/out
#RADQUANT_SOURCES_DIR=/srv/models
# SELinux enforcing (getenforce): relabel bind mounts with :z (recursive, shared container label)
#RADQUANT_SELINUX_RELABEL=1

# Host address:port to publish on. Keep it on loopback (or a LAN / tunnel address) behind a TLS terminator.
#RADQUANT_PUBLISH=127.0.0.1:8740

# Leases and polling; most active leases per worker (a worker gets min(this, its slots = its cards))
#RADQUANT_LEASE_S=120
#RADQUANT_HEARTBEAT_S=30
#RADQUANT_RETRY_S=30
#RADQUANT_MAX_LEASES=16
# Gang jobs (several cards): wait before a busy multi-card worker drains for one; give a drain up after
#RADQUANT_GANG_WAIT_S=0
#RADQUANT_RESERVE_MAX_S=21600

# Spot checks: fraction of each donor's accepted jobs re-run on a verifier, plus every donor's first N per type
#RADQUANT_SPOT_RATE=0.04
#RADQUANT_SPOT_FIRST=1

# Upload caps: largest PUT chunk; a ceiling per file on top of each job type's own caps (0: type caps only);
# total bytes in flight in the spool before uploads get 507 and the worker backs off (0: no cap).
#RADQUANT_CHUNK_MAX_MB=64
#RADQUANT_UPLOAD_MAX_MB=0
#RADQUANT_SPOOL_MAX_GB=0

# Tokens (>= 32 characters, files in $RADQUANT_SECRETS_DIR readable by RADQUANT_UID, e.g. chmod 0400 + chown 10001),
# given as container paths:
#   admin-token   the read-only GET /api/v0/admin/summary
#   search-token  the search's batch API (POST/GET /api/v0/search/batch...: eval_mix on public goldens only)
#RADQUANT_SECRETS_DIR=./secrets
#RADQUANT_ADMIN_TOKEN_FILE=/run/secrets/radquant/admin-token
#RADQUANT_SEARCH_TOKEN_FILE=/run/secrets/radquant/search-token

#RADQUANT_MEM_LIMIT=2g
#RADQUANT_ADMIN_MEM_LIMIT=8g
#RADQUANT_ADMIN_CPUS=8
#RADQUANT_VERBOSE=0

# The public status page (no login, read-only, served at /): rebuilt every N seconds (0: off). STATUS_DIR also
# writes index.html there for a static host (a container path inside OUT, e.g. /srv/radquant/out/status).
# CAMPAIGN: totals and title (default: campaign.json in the DB dir; README "Public status page").
#RADQUANT_STATUS_INTERVAL=60
#RADQUANT_STATUS_DIR=/srv/radquant/out/status
#RADQUANT_CAMPAIGN=/srv/radquant/db/campaign.json
