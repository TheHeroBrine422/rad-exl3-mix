# Copy to .env next to compose.yaml. Never commit or share .env: the invite / token are secrets.
#RADQUANT_IMAGE=docker.io/<hub-user>/radquant-worker:0.2.0-rocm7.14-gfx1201
RADQUANT_SERVER=https://queue.example.org
RADQUANT_INVITE=
RADQUANT_NAME=donor
# 1: list RADQUANT_NAME on the public status page (opt-in; change later with `radquant config set --leaderboard on|off`)
#RADQUANT_LEADERBOARD=0
# getent group video render  ->  the third field of each line
VIDEO_GID=
RENDER_GID=
#RADQUANT_GPU_NAME=r9700
#RADQUANT_GPUS=0
#RADQUANT_VRAM_GB=32
#RADQUANT_RAM_GB=30
#RADQUANT_CACHE_GB=200
#RADQUANT_WINDOWS=22:00-08:00
#RADQUANT_ON_STOP=finish
#TZ=Europe/Berlin
#RADQUANT_STATE_DIR=/srv/radquant-worker
#RADQUANT_MEM_LIMIT=32g
#RADQUANT_STOP_GRACE=15m
