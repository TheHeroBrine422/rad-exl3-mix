+    def inbox_check(self, f):
+        """one file of inbox/, checked without the queue -> ("moved", None, None) when it was handled here (a recorded name, or a reject),
+        ("young", None, None) when its JSON is still being written, else ("ok", sha, spec)"""
+        p = f"{self.R}/inbox/{f}"
+        try: raw = open(p, "rb").read()
+        except OSError: return "moved", None, None                          # moved meanwhile
+        sha = hashlib.sha1(raw).hexdigest()[:16]
+        if f in self.inbox_rec:                                         # a crash between the record and the move: just move it
+            e = self.inbox_rec[f]
+            if e["sha"] == sha:
+                self.log(f"inbox {f}: already submitted as {e['tag']}; moved to done/, not resubmitted"); self.inbox_move(f, "done")
+            else: self.inbox_reject(f, f"name already used by a different file (submitted as {e['tag']})")
+            return "moved", None, None
+        try: d = json.loads(raw)
+        except ValueError as ex:
+            if time.time() - os.path.getmtime(p) < 30: return "young", None, None   # still being written: next pass
+            self.inbox_reject(f, f"not valid JSON ({ex})"); return "moved", None, None
+        why, sp = self.inbox_spec(d)
+        if why: self.inbox_reject(f, why); return "moved", None, None
+        if self.inbox_n(sp) > self.inbox_max:
+            self.inbox_reject(f, f"needs {self.inbox_n(sp)} evals, CONF inbox_max is {self.inbox_max}"); return "moved", None, None
+        return "ok", sha, sp
