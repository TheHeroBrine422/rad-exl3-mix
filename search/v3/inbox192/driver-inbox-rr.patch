+    def inbox_n(self, sp): return 1 + len(sp["extra"])
+
+    def inbox_ready(self, sp, act):
+        """a probe is always ready; a decide needs its size's incumbent scored on the active slice (and no re-seed wait)"""
+        return sp["mode"] == "probe" or (self.scored_on(sp["size"], act) and not self.reseed_wait(sp["size"], act))
+
+    def inbox_take(self, act, room):
+        """(#192-02) one inbox turn: submits the file that goes next, if it fits `room` free slots -> its evals (> 0). 0 when nothing can
+        go this turn (no file, a decide waiting for its incumbent, the inbox cap); -1 when the oldest file fits the cap but needs more
+        than `room` slots: the slot is held for it. Oldest first. With one slot free a waiting decide goes before an older probe, once
+        (inbox_passed): the probe is then the next one-slot pick, so decides cannot starve it."""
+        head = pick = None
+        for f in self.inbox_files():
+            st, sha, sp = self.inbox_check(f)
+            if st == "young": break
+            if st == "moved": continue
+            if head is None:
+                head = pick = (f, sha, sp)
+                if room != 1 or sp["mode"] == "decide" or self.inbox_passed == f: break
+                continue
+            if sp["mode"] == "decide" and self.inbox_n(sp) == 1 and self.inbox_ready(sp, act): pick = (f, sha, sp); break
+        if head is None: return 0
+        f, sha, sp = pick; n = self.inbox_n(sp)
+        if len(self.inbox_out()) + n > self.inbox_max or not self.inbox_ready(sp, act): return 0
+        if n > room: return -1
+        if pick is not head: self.inbox_passed = head[0]
+        self.inbox_submit(f, sha, sp, act)
+        return n
+
+    def inbox_fill(self, act):
+        """(#192-02) the free slots while inbox files wait: each slot goes to the side further below its share of the outstanding evals
+        (inbox: inbox evals / share; own moves: the others / (1 - share)); a tie goes to the side that did not get the previous slot
+        (round robin, the inbox first). A side that cannot use the slot passes it on. Stops when the queue is full, when neither side
+        can use a slot, or when the inbox holds the slot for its oldest file."""
+        for f in self.inbox_files(): self.inbox_check(f)                    # every waiting file is checked (rejects, recorded names) even with no slot free
+        depth = int(self.c.get("queue_depth", 6)); s = self.inbox_share; last = None
+        while True:
+            T = len(self.outstanding()); I = len(self.inbox_out())
+            free = depth - T
+            if free <= 0: return
+            ib = I / s; ow = (T - I) / (1.0 - s) if s < 1 else math.inf
+            first = "inbox" if ib < ow or (ib == ow and last != "inbox") else "own"
+            got = None
+            for side in (first, "own" if first == "inbox" else "inbox"):
+                if side == "inbox":
