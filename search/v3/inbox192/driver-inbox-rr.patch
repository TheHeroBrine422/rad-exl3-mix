+            except OSError: continue                                    # moved meanwhile
+            self.log(f"inbox {f} overflow: {len(fs)} waiting > CONF inbox_pending_max {self.inbox_pending}; moved to inbox/overflow/")
+            self.inbox_move(f, "overflow")
