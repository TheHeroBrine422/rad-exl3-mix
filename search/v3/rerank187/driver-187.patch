+def _generate_reranked(kind, pred, draws, a, lo, hi, seen, rng, rerank, k, tries):
+    """#187: up to k distinct new candidates of one kind, the one the reranker scores lowest (None if none).
+    Stops after `tries` misses in a row (or 2k draws): a stochastic kind rarely repeats, a deterministic one would not fill the pool."""
+    inc = ahash(a); pool = {}; repeats = 0; n = 0
+    while len(pool) < k and repeats < tries and n < 2 * k:
+        n += 1
+        c = _gen(kind, pred, draws, a, lo, hi, rng)
+        h = ahash(c) if c is not None else None
+        if c is not None and h != inc and h not in seen and h not in pool and lo <= pred.M.bytes(c) <= hi:
+            pool[h] = c; repeats = 0
+        else:
+            repeats += 1
+    if not pool: return None
+    return min(pool.values(), key=lambda c: rerank(c, kind))
+
