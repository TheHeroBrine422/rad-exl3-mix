+                                                 "p99": None, "top1": None, "parts": parts, "stopped": stopped}
+                    continue
+                if rc or not os.path.exists(o + ".json.rows"): return {"rc": 1, "err": f"score {tag} {sl['name']}-{pn} rc {rc} ({log})"}
+                full, _ = doc_sums(g, o + ".json.rows")
