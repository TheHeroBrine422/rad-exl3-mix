{
 "name": "gpubox",
 "root": "/data/v3run/multi",
 "run_conf": "/data/v3run/multi/run.json",
 "tree": "/data/v3run/code",
 "slots": {
  "level": 1,
  "eval": 1
 },
 "limits": {
  "kinds": [
   "level",
   "eval"
  ]
 },
 "eval": {
  "packs": "/data/v3run/packs",
  "mixes": "/data/v3run/mixes",
  "scores": "/data/v3run/scores",
  "card": 0,
  "card_lock": "/root/card0.lock",
  "ram_lock": "/root/ram.lock",
  "conv_lock": "/root/conv.lock",
  "aliases": {
   "V2-3.00": "/data/release/qwen3.8-27b-exl3-v2-3.00bpw.rad",
   "V2-4.00": "/data/release/qwen3.8-27b-exl3-v2-4.00bpw.rad"
  },
  "pack_cmd": [
   "bash",
   "-c",
   "cd /workspace && RADIANCE_HOME=/data/swap27/home RADIANCE_HOST_DEVICES=1 /data/swap27/tools/memguard.sh 2500 /data/install-116/bin/rad-convert models/qwen38-27b-bf16 --recipe {recipe} --set quantization_config.quant_method=exl3 -o {out}"
  ],
  "mix_cmd": [
   "/data/swap27/tools/radmix",
   "{out}",
   "{base}",
   "{mixfile}"
  ],
  "score_cmd": [
   "bash",
   "-c",
   "ROCR_VISIBLE_DEVICES={card} RADIANCE_HOME=/data/swap27/home /data/install-116/bin/radiance --model {mix} --tp 1 --kv-cache-dtype bf16 --max-model-len 16384 --max-num-seqs 1 --host-headroom-mib 8192 --kld-ref {golden} --kld-out {out}.json.part > {out}.log 2>&1 && mv {out}.json.part.rows {out}.json.rows && mv {out}.json.part {out}.json"
  ]
 }
}