+/* --kld-progress: a line a document as its last row comes back, in the order they finish, with
+ * the document's KL sum and its per-position KL in FILE.kl; the report's rows are byte for byte
+ * those of a run without it. */
+TEST(progress_lines_follow_documents_and_leave_the_rows_unchanged) {
+    TmpDir t;
+    REQUIRE(!t.path.empty());
+    const std::vector<float> ra = make_logits(40, 11), rb = make_logits(25, 12);
+    record(t.path + "/ref", ra, rb);
+    std::vector<float> ca = ra, cb = rb;
+    std::mt19937 g(13);
+    std::normal_distribution<float> n(0.0f, 0.6f);
+    for (float& v : ca) v += n(g);
+    for (float& v : cb) v += n(g);
+    {
+        Kld k;
+        CHECK_OK(k.score_against(t.path + "/ref", t.path + "/plain.json", V, "candidate"));
+        feed(k, 2, 25, cb);
+        feed(k, 1, 40, ca);
+        CHECK_OK(k.finish());
+    }
+    const std::string prog = t.path + "/prog.jsonl";
+    auto lines = [&] {
+        std::vector<nlohmann::json> v;
+        std::ifstream in(prog);
+        for (std::string l; std::getline(in, l);) if (!l.empty()) v.push_back(nlohmann::json::parse(l));
+        return v;
+    };
+    Kld k;
+    CHECK_OK(k.score_against(t.path + "/ref", t.path + "/prog.json", V, "candidate", prog));
+    /* document b (id 2) first; then half of a: only b's line exists */
+    feed(k, 2, 25, cb);
+    REQUIRE_EQ(lines().size(), (size_t)1);
+    {
+        std::vector<float> part(ca.begin(), ca.begin() + 20 * V);
+        Shards sh(part, 20);
+        CHECK_OK(k.score({ { 1, 0, 20, 0 } }, sh.s));
+    }
+    REQUIRE_EQ(lines().size(), (size_t)1);
+    {
+        std::vector<float> part(ca.begin() + 20 * V, ca.end());
+        Shards sh(part, 20);
+        CHECK_OK(k.score({ { 1, 20, 20, 0 } }, sh.s));
+    }
+    /* a repeated span (re-prefill) writes no second line */
+    {
+        std::vector<float> part(ca.begin() + 20 * V, ca.end());
+        Shards sh(part, 20);
+        CHECK_OK(k.score({ { 1, 20, 20, 0 } }, sh.s));
+    }
+    CHECK_OK(k.finish());
+    const auto L = lines();
+    REQUIRE_EQ(L.size(), (size_t)2);
+    CHECK_EQ(L[0]["doc"].get<int64_t>(), (int64_t)1);
+    CHECK_EQ(L[1]["doc"].get<int64_t>(), (int64_t)0);
+    CHECK_EQ(L[0]["source"].get<std::string>(), std::string("b"));
+    const std::vector<float> plain = read_rows(t.path + "/plain.json.rows");
+    const std::vector<float> rows = read_rows(t.path + "/prog.json.rows");
+    REQUIRE_EQ(rows.size(), plain.size());
+    CHECK(std::memcmp(rows.data(), plain.data(), rows.size() * sizeof(float)) == 0);
+    const std::vector<float> kl = read_rows(prog + ".kl");
+    REQUIRE_EQ(kl.size(), (size_t)55);
+    for (const auto& j : L) {
+        const int64_t row0 = j["row0"], nr = j["rows"], off = j["kl_off"];
+        double s = 0;
+        int64_t t1 = 0;
+        for (int64_t r = 0; r < nr; ++r) {
+            CHECK_EQ(kl[(size_t)(off / 4 + r)], rows[(size_t)((row0 + r) * 4)]);
+            s += (double)rows[(size_t)((row0 + r) * 4)];
+            t1 += (int64_t)rows[(size_t)((row0 + r) * 4 + 3)];
+        }
+        CHECK_EQ(j["kl_sum"].get<double>(), s);
+        CHECK_EQ(j["top1"].get<int64_t>(), t1);
+    }
+    CHECK_EQ(L[0]["rows"].get<int64_t>(), (int64_t)24);
+    CHECK_EQ(L[1]["rows"].get<int64_t>(), (int64_t)31);
+}
