+
+int Kld::progress(const std::vector<KldSpan>& spans) {
+    for (const KldSpan& s : spans) {
+        if (s.id == 0 || s.id > docs_.size() || doc_out_[(size_t)(s.id - 1)]) continue;
+        const Doc& d = docs_[(size_t)(s.id - 1)];
+        int64_t t1 = 0;
+        double sum = 0;
+        bool all = true;
+        for (int64_t r = d.row0; r < d.row0 + d.rows() && all; ++r) all = seen_[(size_t)r] != 0;
+        if (!all) continue;
+        for (int64_t r = d.row0; r < d.row0 + d.rows(); ++r) {
+            sum += (double)kl_[(size_t)r];
+            t1 += top1_[(size_t)r];
+        }
+        doc_out_[(size_t)(s.id - 1)] = 1;
+        const size_t nb = (size_t)d.rows() * sizeof(float);
+        const auto* b = reinterpret_cast<const char*>(kl_.data() + d.row0);
+        for (size_t done = 0; done < nb;) {
+            const ssize_t w = ::write(fd_prog_kl_, b + done, nb - done);
+            if (w < 0 && errno == EINTR) continue;
+            if (w <= 0) { RAD_ERR("kld: cannot write %s.kl", progress_.c_str()); return RAD_E_IO; }
+            done += (size_t)w;
+        }
+        const double t = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count() - t_open_;
+        json j;
+        j["doc"] = (int64_t)(s.id - 1);
+        j["source"] = d.source;
+        j["row0"] = d.row0;
+        j["rows"] = d.rows();
+        j["kl_sum"] = sum;
+        j["top1"] = t1;
+        j["kl_off"] = prog_off_;
+        j["t"] = std::round(t * 1000.0) / 1000.0;
+        prog_off_ += (int64_t)nb;
+        const std::string line = j.dump() + "\n";
+        if (::write(fd_prog_, line.data(), line.size()) != (ssize_t)line.size()) {
+            RAD_ERR("kld: cannot write %s", progress_.c_str());
+            return RAD_E_IO;
+        }
+    }
     return RAD_OK;
 }
 
